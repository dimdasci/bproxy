{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"types": ["chrome", "node"],
		"allowImportingTsExtensions": true,
		"baseUrl": ".",
		"paths": {
			"@": ["src"],
			"@/*": ["src/*"],
			"~": ["src"],
			"~/*": ["src/*"],
			"@@": ["."],
			"@@/*": ["*"],
			"~~": ["."],
			"~~/*": ["*"]
		}
	},
	"include": ["src", "scripts", ".wxt/**/*"]
}
