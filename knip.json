{
	"ignoreBinaries": ["build"],
	"workspaces": {
		"shared": {
			"entry": ["src/protocol-shape.assertions.ts"],
			"project": ["src/**/*.ts"]
		},
		"service": {
			"project": ["src/**/*.ts"]
		},
		"extension": {
			"project": ["src/**/*.ts"],
			"entry": [
				"src/entrypoints/background.ts",
				"src/entrypoints/content.ts",
				"src/entrypoints/popup/main.ts"
			]
		},
		"cli": {
			"project": ["src/**/*.ts"]
		},
		"views": {
			"project": ["src/**/*.ts", "scripts/**/*.ts"]
		}
	},
	"ignore": [".pi/extensions/**", "poc/**", "tools/pi/context-grep/src/**/*.d.mts"],
	"ignoreExportsUsedInFile": true
}
