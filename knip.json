{
	"workspaces": {
		"shared": {
			"project": ["src/**/*.ts"]
		},
		"service": {
			"project": ["src/**/*.ts"]
		},
		"extension": {
			"project": ["src/**/*.ts"],
			"entry": [
				"src/entrypoints/background.ts",
				"src/entrypoints/content.ts",
				"src/entrypoints/popup/main.ts"
			]
		},
		"cli": {
			"project": ["src/**/*.ts"]
		},
		"views": {
			"project": ["src/**/*.ts", "scripts/**/*.ts"]
		}
	},
	"ignore": ["poc/**"],
	"ignoreExportsUsedInFile": true
}
