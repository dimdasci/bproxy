---
import Default from '@astrojs/starlight/components/PageFrame.astro';
import RelatedAdrs from './RelatedAdrs.astro';

// `relatedAdrs` is only present on entries from the `views` collection.
const adrs = (Astro.locals.starlightRoute?.entry.data as { relatedAdrs?: readonly string[] } | undefined)?.relatedAdrs;
---

<Default {...Astro.props}>
  <slot />
  <RelatedAdrs adrs={adrs} />
</Default>
